{
    "name": "phpdevsr/minify-fork",
    "type": "library",
    "description": "CSS & JavaScript minifier, in PHP. Removes whitespace, strips comments, combines files (incl. @import statements and small assets in CSS files), and optimizes/shortens a few common programming patterns. Fork of https://github.com/matthiasmullie/minify",
    "keywords": ["minify", "minifier", "css", "js", "javascript"],
    "homepage": "https://github.com/PHPDevsr/minify-fork",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthias Mullie",
            "homepage": "https://www.mullie.eu",
            "email": "minify@mullie.eu",
            "role": "Original Developer"
        },
        {
            "name": "PHPDevsr",
            "homepage": "https://github.com/PHPDevsr",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pcre": "*",
        "phpdevsr/path-converter-fork": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "nexusphp/cs-config": "^3.28",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0"
    },
    "suggest": {
        "psr/cache-implementation": "Cache implementation to use with Minify::cache"
    },
    "autoload": {
        "psr-4": {
            "PHPDevsr\\Minify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPDevsr\\Minify\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/minifycss",
        "bin/minifyjs"
    ],
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "cs": [
            "vendor/bin/php-cs-fixer fix --ansi --verbose --dry-run --diff"
        ],
        "cs-fix": [
            "vendor/bin/php-cs-fixer fix --ansi --verbose --diff"
        ],
        "analyze": [
            "Composer\\Config::disableProcessTimeout",
            "@phpstan",
            "@rector"
        ],
        "rector": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "phpstan": "bash -c \"XDEBUG_MODE=off phpstan analyse\"",
        "phpstan-baseline": "bash -c \"XDEBUG_MODE=off phpstan analyse --generate-baseline=phpstan-baseline.neon\""
    }
}
